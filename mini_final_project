#include <MK64F12.h>
 
#define MASK(x) (1UL << (x))
 
// --- Global Variables --- v.2
volatile int score_p1 = 0;        // Player 1 Score (0-9) -> Tens digit
volatile int score_p2 = 0;        // Player 2 Score (0-9) -> Ones digit
 
// Game States: 0 = Idle, 1 = Waiting (Random delay), 2 = Ready (GO!), 3 = Round Over
volatile int game_state = 0;      
volatile int wait_ticks = 0;      // Countdown ticks (0.1s each) before GO!
volatile int random_seed = 15;    // Counter for pseudo-random delay
 
// Rhythmic Buzzer Variables
volatile int beep_pulses = 0;     // Number of half-cycles remaining
volatile int buzzer_state = 0;    // 0 = OFF, 1 = ON
 
// 7-Segment lookup table for digits 0-9 (Common Anode: 0 = ON, 1 = OFF)
const uint8_t SEGMENT_MAP[10] = {0xC0, 0xF9, 0xA4, 0xB0, 0x99, 0x92, 0x82, 0xF8, 0x80, 0x90};
// Digit selection lookup table (Ones = P2, Tens = P1)
const uint8_t DIGIT_MAP[2]    = {0xF8, 0xF4};
 
void delay_ms(uint32_t ms) {
    for (uint32_t i = 0; i < ms * 10000; i++) {
        __NOP();
    }
}
 
// Helper functions to cleanly turn Buzzer ON/OFF on 5V Shield from 3.3V MCU
void buzzer_on(void) {
    PORTA->PCR[1] = (PORTA->PCR[1] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PTA->PDDR |= MASK(1);  // Set as Output
    PTA->PCOR = MASK(1);   // Drive LOW (0V) -> Buzzer ON
    buzzer_state = 1;
}
 
void buzzer_off(void) {
    PTA->PSOR = MASK(1);   // Drive HIGH
    PTA->PDDR &= ~MASK(1); // Set as Input (High-Z) to completely cut base current
    PORTA->PCR[1] = (PORTA->PCR[1] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(0); // Disable pin
    buzzer_state = 0;
}
 
// =========================================================================
// 1. Initialization Functions
// =========================================================================
 
void init_GPIO(void) {
    delay_ms(1000); // 1s startup delay to ensure SWD/JTAG connection stability
 
    // Enable clock for Port A, B, C, and D
    SIM->SCGC5 |= SIM_SCGC5_PORTA_MASK | SIM_SCGC5_PORTB_MASK | 
                  SIM_SCGC5_PORTC_MASK | SIM_SCGC5_PORTD_MASK;
 
    // --- Initialize Buzzer (PTA1) in OFF state ---
    buzzer_off();
 
    // --- Configure Switches: S1(PTB3 = Start), S2(PTB10 = P1), S3(PTB11 = P2) ---
    PORTB->PCR[3]  = (PORTB->PCR[3]  & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTB->PCR[10] = (PORTB->PCR[10] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTB->PCR[11] = (PORTB->PCR[11] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PTB->PDDR &= ~(MASK(3) | MASK(10) | MASK(11)); // Set as Input
 
    // --- Configure Shield LEDs: D4(PTD0), D1(PTD1), D3(PTD2), D2(PTD3) ---
    PORTD->PCR[0] = (PORTD->PCR[0] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PORTD->PCR[1] = (PORTD->PCR[1] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PORTD->PCR[2] = (PORTD->PCR[2] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PORTD->PCR[3] = (PORTD->PCR[3] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PTD->PDDR |= (MASK(0) | MASK(1) | MASK(2) | MASK(3)); // Set as Output
    PTD->PSOR  = (MASK(0) | MASK(1) | MASK(2) | MASK(3)); // Turn OFF all LEDs (Active Low)
 
    // --- Configure 7-Segment (74HC595): Latch(PTB23), Clock(PTC3), Data(PTC12) ---
    PORTB->PCR[23] = (PORTB->PCR[23] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PTB->PDDR |= MASK(23);
 
    PORTC->PCR[3]  = (PORTC->PCR[3]  & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PORTC->PCR[12] = (PORTC->PCR[12] & ~PORT_PCR_MUX_MASK) | PORT_PCR_MUX(1);
    PTC->PDDR |= (MASK(3) | MASK(12));
}
 
void init_PIT_Timer(void) {
    // Enable clock for PIT (Periodic Interrupt Timer)
    SIM->SCGC6 |= SIM_SCGC6_PIT_MASK;
    PIT->MCR = 0x00;
 
    // Set interrupt interval to 0.1 seconds (assuming 60MHz Bus Clock)
    PIT->CHANNEL[0].LDVAL = 5999999; 
    PIT->CHANNEL[0].TCTRL = PIT_TCTRL_TIE_MASK | PIT_TCTRL_TEN_MASK;
 
    // Enable PIT0 interrupt in NVIC
    NVIC_EnableIRQ(PIT0_IRQn);
}
 
// =========================================================================
// 2. Peripheral Control Functions
// =========================================================================
 
void shift_out_595(uint8_t data) {
    for (int i = 0; i < 8; i++) {
        if (data & (1 << (7 - i))) {
            PTC->PSOR = MASK(12); // Data = 1
        } else {
            PTC->PCOR = MASK(12); // Data = 0
        }
        PTC->PSOR = MASK(3);      // Clock = 1
        __NOP();
        PTC->PCOR = MASK(3);      // Clock = 0
    }
}
 
void update_7segment(int p1, int p2) {
    // Display Player 2 score on Ones digit (Right)
    PTB->PCOR = MASK(23);             // Latch = 0
    shift_out_595(SEGMENT_MAP[p2]);
    shift_out_595(DIGIT_MAP[0]);
    PTB->PSOR = MASK(23);             // Latch = 1
    delay_ms(2);
 
    // Display Player 1 score on Tens digit (Left)
    PTB->PCOR = MASK(23);             // Latch = 0
    shift_out_595(SEGMENT_MAP[p1]);
    shift_out_595(DIGIT_MAP[1]);
    PTB->PSOR = MASK(23);             // Latch = 1
    delay_ms(2);
}
 
// Trigger rhythmic beeps ONLY when called (count = number of beeps)
void start_buzzer_rhythm(int count) {
    beep_pulses = (count * 2) - 1;
    buzzer_on();
}
 
void read_switches(void) {
    // Press S1 (PTB3) -> Start new round (or reset scores if someone reached 9)
    if ((PTB->PDIR & MASK(3)) == 0) {
        if (game_state == 0 || game_state == 3) {
            if (score_p1 >= 9 || score_p2 >= 9) {
                score_p1 = 0;
                score_p2 = 0;
            }
            // Turn OFF all LEDs and Buzzer before starting
            PTD->PSOR = (MASK(0) | MASK(1) | MASK(2) | MASK(3));
            beep_pulses = 0;
            buzzer_off();
            // Generate random delay between 1.5s to 4.5s (15 to 45 ticks)
            wait_ticks = 15 + (random_seed % 31);
            game_state = 1; // Enter Waiting State
        }
        while ((PTB->PDIR & MASK(3)) == 0) {
            update_7segment(score_p1, score_p2);
        }
        delay_ms(50);
    }
 
    // Check Player 1 (S2 = PTB10) and Player 2 (S3 = PTB11) during GO! state (game_state == 2)
    if (game_state == 2) {
        // Player 1 presses first!
        if ((PTB->PDIR & MASK(10)) == 0) {
            game_state = 3; // Round Over
            if (score_p1 < 9) score_p1++;
            PTD->PSOR = (MASK(0) | MASK(1) | MASK(3)); // Turn OFF D4, D1, D2
            PTD->PCOR = MASK(2);                       // Turn ON LED D3 (Player 1 Win!)
            start_buzzer_rhythm(3);                    // Beep 3 times then stop!
        }
        // Player 2 presses first!
        else if ((PTB->PDIR & MASK(11)) == 0) {
            game_state = 3; // Round Over
            if (score_p2 < 9) score_p2++;
            PTD->PSOR = (MASK(1) | MASK(2) | MASK(3)); // Turn OFF D1, D3, D2
            PTD->PCOR = MASK(0);                       // Turn ON LED D4 (Player 2 Win!)
            start_buzzer_rhythm(3);                    // Beep 3 times then stop!
        }
    }
    // Penalty: Foul if pressed too early during Waiting state (game_state == 1)!
    else if (game_state == 1) {
        // Player 1 fouled -> Point goes to Player 2!
        if ((PTB->PDIR & MASK(10)) == 0) {
            game_state = 3;
            if (score_p2 < 9) score_p2++;
            PTD->PSOR = (MASK(1) | MASK(2) | MASK(3));
            PTD->PCOR = MASK(0);      // LED D4 ON (P2 wins by P1 foul)
            start_buzzer_rhythm(5);   // Beep 5 times rapidly then stop!
        }
        // Player 2 fouled -> Point goes to Player 1!
        else if ((PTB->PDIR & MASK(11)) == 0) {
            game_state = 3;
            if (score_p1 < 9) score_p1++;
            PTD->PSOR = (MASK(0) | MASK(1) | MASK(3));
            PTD->PCOR = MASK(2);      // LED D3 ON (P1 wins by P2 foul)
            start_buzzer_rhythm(5);   // Beep 5 times rapidly then stop!
        }
    }
}
 
// =========================================================================
// 3. Interrupt Service Routine (ISR)
// =========================================================================
 
// PIT0 Timer Interrupt every 0.1 seconds
void PIT0_IRQHandler(void) {
    random_seed++; // Continuously increment seed for random timing
 
    // Handle Rhythmic Buzzer Pulses
    if (beep_pulses > 0) {
        beep_pulses--;
        if (buzzer_state == 1) {
            buzzer_off();
        } else {
            buzzer_on();
        }
    } else if (buzzer_state == 1) {
        buzzer_off();
    }
 
    // Handle Waiting State (Random countdown before GO!)
    if (game_state == 1) {
        if (wait_ticks > 0) {
            wait_ticks--;
            // Blink LED D1 & D2 together every 0.2s while waiting (Silent)
            if (wait_ticks % 2 == 0) {
                PTD->PTOR = (MASK(1) | MASK(3));
            }
        } else {
            // Time is up -> GO! (Silent, LEDs D1 & D2 turn ON solid)
            game_state = 2;
            PTD->PCOR = (MASK(1) | MASK(3)); 
        }
    }
 
    // Clear Timer Interrupt Flag
    PIT->CHANNEL[0].TFLG = PIT_TFLG_TIF_MASK;
}
 
// =========================================================================
// 4. Main Function
// =========================================================================
 
int main(void) {
    init_GPIO();
    init_PIT_Timer();
 
    while (1) {
        read_switches();
        update_7segment(score_p1, score_p2);
    }
}